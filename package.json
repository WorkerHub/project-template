{
  "name": "project-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:web && concurrently \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter ./web dev",
    "dev:worker": "pnpm --filter ./worker dev",
    "build": "pnpm build:web && pnpm build:worker",
    "build:web": "pnpm --filter ./web build",
    "build:worker": "pnpm --filter ./worker build",
    "typecheck": "pnpm --filter ./web typecheck && pnpm --filter ./worker typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "pnpm --filter ./worker test && pnpm --filter ./web test",
    "check:identity": "node scripts/check-identity.mjs",
    "check:deploy": "pnpm build:web && pnpm --filter ./worker exec wrangler deploy --dry-run",
    "schema:sql": "pnpm --filter ./worker schema:sql",
    "predev": "node scripts/build-info.mjs",
    "prebuild": "node scripts/build-info.mjs",
    "pretypecheck": "node scripts/build-info.mjs",
    "pretest": "node scripts/build-info.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0"
}
